{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gm.com/lifecycle/v1.1/defect.schema.json",
  "title": "Defect record (spec §12.2, §12.3, §12.4)",
  "type": "object",
  "required": ["id", "feature", "summary", "reproduction", "introduced_at",
               "detected_at", "root_cause", "process_originated",
               "symptom_correction", "regression_verification"],
  "properties": {
    "id": { "type": "string", "pattern": "^DEF-[0-9]+$" },
    "feature": { "type": "string" },
    "summary": { "type": "string" },
    "reproduction": {
      "type": "object",
      "required": ["deterministic"],
      "properties": {
        "deterministic": { "type": "boolean" },
        "steps": { "type": "array", "items": { "type": "string" } }
      }
    },
    "introduced_at": {
      "description": "escape point — where it was INTRODUCED (§12.1)",
      "enum": ["requirement", "acceptance_criterion", "scenario", "architecture",
               "interface_contract", "detailed_design", "implementation",
               "environment_configuration"]
    },
    "detected_at": {
      "enum": ["unit", "integration", "system", "validation", "production"]
    },
    "escape_path": { "type": "array", "items": { "type": "string" } },
    "root_cause": {
      "type": "string",
      "description": "why it was possible, not just what is wrong"
    },
    "process_originated": {
      "type": "boolean",
      "description": "§12.2 — was a lifecycle artifact or process inadequate? Drives whether escape correction is required."
    },
    "process_originated_reasoning": { "type": "string" },
    "symptom_correction": {
      "type": "object",
      "description": "always required — fix the software so the defect no longer exists",
      "required": ["description"],
      "properties": {
        "description": { "type": "string" },
        "elements_changed": { "type": "array", "items": { "type": "string" } },
        "tests_added": { "type": "array", "items": { "type": "string" } }
      }
    },
    "escape_correction": {
      "type": "object",
      "description": "required only when process_originated is true (§12.2)",
      "required": ["artifact_or_process_changed", "description"],
      "properties": {
        "artifact_or_process_changed": {
          "type": "array",
          "items": {
            "enum": ["requirement", "acceptance_criterion", "scenario",
                     "matrix_dimension", "design_rule", "pattern_constraint",
                     "contract_clause", "test_case", "checklist_item",
                     "template"]
          },
          "minItems": 1
        },
        "description": { "type": "string" },
        "reentry_phase": { "type": "string" },
        "gates_reopened": { "type": "array", "items": { "type": "string" } }
      }
    },
    "regression_verification": {
      "type": "object",
      "description": "§12.4 — RED→GREEN preferred, with a controlled exception",
      "required": ["mode", "test"],
      "properties": {
        "mode": { "enum": ["red_green", "exception"] },
        "test": { "type": "string" },
        "red_evidence": { "type": "string" },
        "green_evidence": { "type": "string" },
        "exception": {
          "type": "object",
          "required": ["condition", "why", "alternative_evidence",
                       "reviewer_approval"],
          "properties": {
            "condition": {
              "enum": ["production_only_environment", "hardware_only_failure",
                       "timing_dependent_failure", "nondeterministic_race",
                       "external_backend_condition", "unavailable_old_build",
                       "safety_validation_environment"]
            },
            "why": { "type": "string" },
            "alternative_evidence": {
              "type": "array",
              "description": "at least two items; fewer than two fails G7",
              "items": { "type": "string" },
              "minItems": 2
            },
            "reviewer_approval": {
              "type": "object",
              "required": ["agent_id", "role", "session_id", "timestamp"],
              "properties": {
                "agent_id": { "type": "string" },
                "role": { "type": "string" },
                "session_id": { "type": "string" },
                "timestamp": { "type": "string", "format": "date-time" }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "exception" } },
                  "required": ["mode"] },
          "then": { "required": ["mode", "test", "exception"] }
        },
        {
          "if": { "properties": { "mode": { "const": "red_green" } },
                  "required": ["mode"] },
          "then": { "required": ["mode", "test", "red_evidence", "green_evidence"] }
        }
      ]
    },
    "disposition": { "enum": ["fixed", "deferred", "accepted_limitation",
                              "not_a_defect", "duplicate"] },
    "disposition_rationale": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "process_originated": { "const": true } },
              "required": ["process_originated"] },
      "then": { "required": ["escape_correction"] }
    }
  ]
}
