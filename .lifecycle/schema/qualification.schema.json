{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gm.com/lifecycle/v1.1/qualification.schema.json",
  "title": "F0 feature qualification (spec §3)",
  "type": "object",
  "required": ["feature", "type", "complexity", "impact_flags", "depth",
               "phases_required", "gates_required"],
  "properties": {
    "feature": { "type": "string" },
    "title": { "type": "string" },
    "type": {
      "description": "§3.1 — exactly one primary type",
      "enum": ["new_feature", "enhancement", "bug_fix", "refactoring",
               "performance", "security", "safety_related", "regulatory",
               "configuration"]
    },
    "complexity": { "enum": ["L0", "L1", "L2", "L3", "L4"] },
    "impact_flags": {
      "type": "object",
      "description": "§3.3 — all answered explicitly; no field may be omitted",
      "required": ["contract_change", "public_api_change", "data_change",
                   "persistent_data_change", "security_sensitive",
                   "safety_relevant", "customer_visible", "backend_change",
                   "regulatory", "concurrency_change"],
      "additionalProperties": false,
      "properties": {
        "contract_change": { "type": "boolean" },
        "public_api_change": { "type": "boolean" },
        "data_change": { "type": "boolean" },
        "persistent_data_change": { "type": "boolean" },
        "security_sensitive": { "type": "boolean" },
        "safety_relevant": { "type": "boolean" },
        "customer_visible": { "type": "boolean" },
        "backend_change": { "type": "boolean" },
        "regulatory": { "type": "boolean" },
        "concurrency_change": { "type": "boolean" }
      }
    },
    "depth_floors_applied": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["trigger", "floor"],
        "properties": {
          "trigger": { "type": "string" },
          "floor": { "enum": ["L0", "L1", "L2", "L3", "L4"] },
          "applies": { "type": "boolean" }
        }
      }
    },
    "depth": {
      "description": "resulting depth after flags and floors; ambiguity resolves upward",
      "enum": ["L0", "L1", "L2", "L3", "L4"]
    },
    "depth_rationale": { "type": "string" },
    "phases_required": {
      "type": "array", "items": { "type": "string" }, "minItems": 1
    },
    "gates_required": { "type": "array", "items": { "type": "string" } },
    "ui_surface": { "type": "boolean", "description": "drives G5/G6 applicability" },
    "authorship": {
      "type": "object",
      "required": ["agent_id", "role", "session_id", "timestamp"],
      "properties": {
        "agent_id": { "type": "string" },
        "role": { "const": "team-lead" },
        "session_id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    }
  }
}
