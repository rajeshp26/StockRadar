{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gm.com/lifecycle/v1.1/gate.schema.json",
  "title": "Gate ledger entry (spec §9.1, §9.1.1, §9.1.2)",
  "type": "object",
  "required": ["gate", "feature", "verdict", "baseline_certified_against",
               "authorship", "artifacts_inspected", "checklist", "evidence",
               "timestamp"],
  "properties": {
    "gate": {
      "enum": ["G0", "G0.5", "G1", "G2", "G3", "G3.5", "G4", "G5", "G6",
               "G7", "G8-A", "G8-B"]
    },
    "feature": { "type": "string" },
    "verdict": { "enum": ["PASS", "FAIL", "CONDITIONAL", "NOT_APPLICABLE"] },
    "baseline_certified_against": { "type": "string", "pattern": "^BL-" },
    "authorship": {
      "type": "object",
      "description": "§9.1.1 — identity-based independence",
      "required": ["author", "certifier", "independence_rule_applied"],
      "properties": {
        "author": { "$ref": "#/definitions/identity" },
        "additional_authors": {
          "type": "array", "items": { "$ref": "#/definitions/identity" }
        },
        "contributors": {
          "type": "array",
          "items": { "$ref": "#/definitions/identity" },
                    "description": "L4 requires author + at least one contributor or additional_author (§9.1.1 role_and_identity)"
        },
        "certifier": { "$ref": "#/definitions/identity" },
        "independence_rule_applied": { "enum": ["identity", "role_and_identity"] }
      }
    },
    "artifacts_inspected": {
      "type": "array", "items": { "type": "string" }, "minItems": 1
    },
    "checklist": { "type": "string" },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/evidence_item" }
    },
    "orphan_counts": {
      "type": "object",
      "description": "§8.4 — required at G3.5, G7, G8",
      "properties": {
        "requirement": { "type": "integer", "minimum": 0 },
        "scenario": { "type": "integer", "minimum": 0 },
        "test": { "type": "integer", "minimum": 0 },
        "component": { "type": "integer", "minimum": 0 },
        "contract": { "type": "integer", "minimum": 0 },
        "code": { "type": "integer", "minimum": 0 },
        "impact": { "type": "integer", "minimum": 0 },
        "state": { "type": "integer", "minimum": 0 },
        "risk": { "type": "integer", "minimum": 0 },
        "stale_baseline": { "type": "integer", "minimum": 0 }
      }
    },
    "conditions": {
      "type": "array",
      "description": "required when verdict is CONDITIONAL (§9.1)",
      "items": {
        "type": "object",
        "required": ["condition", "owner", "recheck_date"],
        "properties": {
          "condition": { "type": "string" },
          "owner": { "type": "string" },
          "recheck_date": { "type": "string", "format": "date" }
        }
      }
    },
    "recommendation": {
      "description": "G8 Part B only (§9.3); a recommendation, not a decision",
      "enum": ["RECOMMEND_RELEASE", "RECOMMEND_RELEASE_WITH_LIMITATIONS",
               "RECOMMEND_HOLD"]
    },
    "timestamp": { "type": "string", "format": "date-time" }
  },
  "definitions": {
    "identity": {
      "type": "object",
      "required": ["agent_id", "role", "session_id", "timestamp"],
      "properties": {
        "agent_id": { "type": "string", "minLength": 1 },
        "role": {
          "enum": ["team-lead", "researcher", "architect", "planner",
                   "implementer", "reviewer", "verifier", "human"]
        },
        "session_id": { "type": "string", "minLength": 1 },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "evidence_item": {
      "type": "object",
      "description": "§9.1.2 — immutable reference; an assertion with no result file fails",
      "required": ["claim", "command", "commit", "environment", "timestamp",
                   "result_file", "checksum"],
      "properties": {
        "claim": { "type": "string" },
        "command": { "type": "string" },
        "commit": { "type": "string", "minLength": 7 },
        "environment": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "result_file": { "type": "string" },
        "checksum": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "measured_value": { "type": "string" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "verdict": { "const": "CONDITIONAL" } },
              "required": ["verdict"] },
      "then": { "required": ["conditions"] }
    },
    {
      "if": { "properties": { "gate": { "enum": ["G0", "G0.5", "G7", "G8-A", "G8-B"] } },
              "required": ["gate"] },
      "then": { "properties": { "verdict": { "not": { "const": "CONDITIONAL" } } } }
    },
    {
      "if": { "properties": { "gate": { "const": "G8-B" } }, "required": ["gate"] },
      "then": { "required": ["recommendation"] }
    }
  ]
}
