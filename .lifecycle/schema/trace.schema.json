{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gm.com/lifecycle/v1.1/trace.schema.json",
  "title": "Traceability graph (spec §8.3)",
  "type": "object",
  "required": ["feature", "spec_version"],
  "properties": {
    "feature": { "type": "string" },
    "spec_version": { "const": "1.1" },
    "customers": {
      "type": "object",
      "patternProperties": {
        "^CUS-[0-9]+$": {
          "type": "object",
          "required": ["name"],
          "properties": { "name": { "type": "string" } }
        }
      }
    },
    "journeys": {
      "type": "object",
      "patternProperties": {
        "^JRN-[0-9]+$": {
          "type": "object",
          "required": ["customer", "title"],
          "properties": {
            "customer": { "type": "string", "pattern": "^CUS-" },
            "title": { "type": "string" }
          }
        }
      }
    },
    "use_cases": {
      "type": "object",
      "patternProperties": {
        "^UC-[0-9]+$": {
          "type": "object",
          "required": ["journeys"],
          "properties": {
            "journeys": { "type": "array", "items": { "pattern": "^JRN-" }, "minItems": 1 },
            "scenarios": { "type": "array", "items": { "pattern": "^SCN-" } },
            "components": { "type": "array", "items": { "pattern": "^CMP-" } }
          }
        }
      }
    },
    "scenarios": {
      "type": "object",
      "description": "§5.2.2 priority dimension is mandatory; unscored SCN is an orphan risk",
      "patternProperties": {
        "^SCN-[0-9]+$": {
          "type": "object",
          "required": ["priority"],
          "properties": {
            "title": { "type": "string" },
            "class": {
              "enum": ["normal", "alternate", "negative", "failure", "recovery",
                       "interrupted", "repeated", "boundary", "concurrent",
                       "persistence", "upgrade", "downgrade", "rollback",
                       "security", "performance", "safety", "misuse",
                       "unexpected_sequence"]
            },
            "technique": {
              "description": "§5.2.1 — which selection technique produced this",
              "enum": ["equivalence", "boundary", "pairwise", "state_transition",
                       "risk_based", "domain_mandatory"]
            },
            "priority": {
              "type": "object",
              "required": ["likelihood", "impact", "detectability"],
              "properties": {
                "likelihood": { "type": "integer", "minimum": 1, "maximum": 5 },
                "impact": { "type": "integer", "minimum": 1, "maximum": 5 },
                "detectability": { "type": "integer", "minimum": 1, "maximum": 5 },
                "priority": { "type": "integer", "minimum": 1, "maximum": 125 },
                "band": { "enum": ["low", "medium", "high", "critical"] }
              }
            },
            "cases": { "type": "array", "items": { "type": "string" } },
            "deferred": { "type": "boolean" },
            "deferral_reason": { "type": "string" },
            "unreachable_reason": { "type": "string" }
          }
        }
      }
    },
    "stories": {
      "type": "object",
      "patternProperties": {
        "^US-[0-9]+$": {
          "type": "object",
          "required": ["use_case", "criteria"],
          "properties": {
            "use_case": { "type": "string", "pattern": "^UC-" },
            "criteria": { "type": "array", "items": { "pattern": "^AC-" }, "minItems": 1 },
            "scenarios": { "type": "array", "items": { "pattern": "^SCN-" } }
          }
        }
      }
    },
    "nfrs": {
      "type": "object",
      "patternProperties": {
        "^NFR-[0-9]+$": {
          "type": "object",
          "required": ["statement", "threshold", "method"],
          "properties": {
            "statement": { "type": "string" },
            "threshold": { "type": "string", "description": "measurable; 'fast' fails G0" },
            "method": { "type": "string", "description": "how it is measured" },
            "measured_value": { "type": "string", "description": "recorded at G7/G8 Part B" },
            "design": { "type": "array", "items": { "pattern": "^DES-" } },
            "conditions": { "type": "array", "items": { "pattern": "^TC-" } },
            "baseline": { "type": "string", "pattern": "^BL-" }
          }
        }
      }
    },
    "states": {
      "type": "object",
      "description": "§6.5 ownership register; exactly one owner or it is an orphan state",
      "patternProperties": {
        "^.+$": {
          "type": "object",
          "required": ["owner", "readers", "writers"],
          "properties": {
            "owner": { "type": "string", "pattern": "^CMP-" },
            "readers": { "type": "array", "items": { "pattern": "^CMP-" } },
            "writers": { "type": "array", "items": { "pattern": "^CMP-" } },
            "persistence": { "type": "string" },
            "synchronization": { "type": "string" },
            "control_scope": { "enum": ["vehicle", "seat", "shared_vehicle"] },
            "concurrency": {
              "type": "object",
              "description": "§6.6 — all nine required where concurrently mutable",
              "properties": {
                "consistency_model": { "type": "string" },
                "serialization_mechanism": { "type": "string" },
                "conflict_resolution": { "type": "string" },
                "deterministic_winner": { "type": "string" },
                "ordering": { "type": "string" },
                "atomicity": { "type": "string" },
                "race_prevention": { "type": "string" },
                "reentrancy": { "type": "string" },
                "thread_safety": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "components": {
      "type": "object",
      "patternProperties": {
        "^CMP-[0-9]+$": {
          "type": "object",
          "required": ["responsibility"],
          "properties": {
            "responsibility": { "type": "string" },
            "layer": { "type": "string" },
            "cohesion_justification": { "type": "string" }
          }
        }
      }
    },
    "design": {
      "type": "object",
      "patternProperties": {
        "^DES-[0-9]+$": {
          "type": "object",
          "properties": {
            "component": { "type": "string", "pattern": "^CMP-" },
            "satisfies": { "type": "array", "items": { "pattern": "^(AC|NFR)-" } },
            "contracts": { "type": "array", "items": { "pattern": "^(IFC|EVT)-" } },
            "units": { "type": "array", "items": { "pattern": "^IMP-" } },
            "baseline": { "type": "string", "pattern": "^BL-" }
          }
        }
      }
    },
    "contracts": {
      "type": "object",
      "patternProperties": {
        "^(IFC|EVT)-[0-9]+$": {
          "type": "object",
          "properties": {
            "owner": { "type": "string" },
            "publisher": { "type": "string" },
            "consumers": { "type": "array", "items": { "type": "string" } },
            "subscribers": { "type": "array", "items": { "type": "string" } },
            "boundary": { "enum": ["in_process", "ipc", "network"] },
            "tests": { "type": "array", "items": { "type": "string" } },
            "baseline": { "type": "string", "pattern": "^BL-" }
          }
        }
      }
    },
    "units": {
      "type": "object",
      "patternProperties": {
        "^IMP-[0-9]+$": {
          "type": "object",
          "required": ["path"],
          "properties": {
            "path": { "type": "string" },
            "satisfies": { "type": "array", "items": { "pattern": "^(AC|NFR)-" } },
            "tests": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "tests": {
      "type": "object",
      "patternProperties": {
        "^(TC|UT|IT|ST|VT)-[0-9]+$": {
          "type": "object",
          "required": ["covers"],
          "properties": {
            "covers": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
            "type": { "type": "string" },
            "technique": { "type": "string" },
            "surface": { "type": "string" },
            "audible_outcome": {
              "type": "boolean",
              "description": "true only where a real audio path is asserted"
            },
            "result": { "enum": ["pass", "fail", "not_run", "flaky"] },
            "kind": {
              "type": "string",
              "enum": ["verified_by", "validated_by"],
              "description": "UT/IT/ST verify ('verified_by'); VT validates ('validated_by') — hardening H7"
            },
            "evidence": { "type": "string", "description": "evidence item reference" }
          }
        }
      }
    },
    "changed_files": { "type": "array", "items": { "type": "string" } },
    "impacted_paths": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["changed", "regression"],
        "properties": {
          "changed": { "type": "string" },
          "dependents": { "type": "array", "items": { "type": "string" } },
          "regression": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "executed": { "type": "boolean" }
        }
      }
    },
    "baselines": {
      "type": "object",
      "description": "§8.6 — created at G0, G1 and G3.5",
      "patternProperties": {
        "^BL-[A-Z0-9-]+$": {
          "type": "object",
          "required": ["kind", "created", "approved_by", "git_commit", "status"],
          "properties": {
            "kind": { "enum": ["requirements", "contracts", "design"] },
            "created": { "type": "string", "format": "date-time" },
            "approved_by": { "type": "string" },
            "git_commit": { "type": "string" },
            "status": { "enum": ["current", "superseded"] },
            "superseded_by": { "type": "string", "pattern": "^BL-" }
          }
        }
      }
    },
    "element_baselines": {
      "type": "object",
      "description": "element id -> baseline id it belongs to",
      "additionalProperties": { "type": "string" }
    },
    "changes": {
      "type": "array",
      "description": "§8.6 rule 3 supersession record",
      "items": {
        "type": "object",
        "required": ["baseline", "changed", "before", "after", "reason",
                     "impact", "gates_reopened"],
        "properties": {
          "baseline": { "type": "string", "pattern": "^BL-" },
          "changed": { "type": "string" },
          "before": { "type": "string" },
          "after": { "type": "string" },
          "reason": { "type": "string" },
          "impact": { "type": "array", "items": { "type": "string" } },
          "gates_reopened": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
