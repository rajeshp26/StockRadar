# Backend Environment Variables (.env.example)
# Copy this file to .env and fill in the values

# ===========================================
# ??? Database (Supabase)
# ===========================================
# Get these from your Supabase project settings
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ===========================================
# Cloud Supabase (Optional — migration/recovery tooling only)
# ===========================================
# Required by scripts/backup_cloud.py and scripts/probe_cloud_recovery_source.py
# to reach a remote Supabase project. Leave unset for normal local operation;
# those scripts exit with a clear error rather than falling back to a default.
# Never commit real values — keep them in .env (git-ignored).
# SUPABASE_CLOUD_URL=https://your-project-ref.supabase.co
# SUPABASE_CLOUD_SERVICE_ROLE_KEY=your_cloud_service_role_key_here

# ===========================================
# ?? Authentication (Firebase)
# ===========================================
# This should match the Project ID in your Firebase project
FIREBASE_PROJECT_ID=your_firebase_project_id_here

# ===========================================
# ?? AI & External Providers (Optional)
# ===========================================
# Get this from https://openrouter.ai/keys
# OPEN_ROUTER_KEY=your_openrouter_key_here
# OPEN_ROUTER_MODEL=openai/gpt-oss-120b:free

# Required by SEC for EDGAR rate-limiting (any valid email address works).
# See https://www.sec.gov/developer
EDGAR_IDENTITY="YourName yourname@example.com"
