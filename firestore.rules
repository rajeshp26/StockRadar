/**
 * This ruleset enforces a strict user-ownership model for the StockerPro application.
 * All user-specific data, such as watchlists, is stored in subcollections under that user's
 * unique document, ensuring that users can only access their own information.
 *
 * Core Philosophy: A user has complete control over their own data tree, and no access
 * to any other user's data. Global data, like stock information, is publicly readable
 * but not writable by clients.
 *
 * Data Structure:
 * - /users/{userId}: A user's private profile document.
 * - /users/{userId}/watchlist/{watchlistItemId}: A user's private list of stocks they are watching.
 * - /stocks/{stockId}: A global, read-only collection of stock information available to all users.
 *
 * Key Security Decisions:
 * - User Enumeration is Disallowed: The top-level `/users` collection cannot be listed,
 *   preventing malicious actors from scraping a list of all application users.
 * - Path-Based Security: All rules for user-specific data rely on the `{userId}` wildcard in
 *   the path, making queries and rules simple and performant.
 * - Relational Integrity: On creation, documents within a user's data tree (like a WatchlistItem)
 *   must contain a `userId` field that matches the ID in the path, ensuring data consistency.
 *   This ownership link is immutable once created.
 * - Read-Only Global Data: The `/stocks` collection is treated as a public, read-only dataset.
 *   Writes are explicitly disabled, assuming this data is managed by a trusted backend process.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------------------
    // Helper Functions
    // ----------------------------------------------------------------------

    /**
     * Checks if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the currently authenticated user's UID matches the given userId.
     * This is the primary function for enforcing data ownership.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Checks if the user is the owner and the document already exists.
     * CRITICAL: Used for all update and delete operations to prevent modifying
     * or deleting non-existent data, which is a potential security risk.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * Validates a new User document on creation.
     * Ensures the document data is correctly linked to the user's auth ID.
     */
    function isValidNewUserDoc(userId) {
      return request.resource.data.id == userId;
    }

    /**
     * Validates a User document on update.
     * Enforces immutability of the critical 'id' field to prevent re-linking.
     */
    function isImmutableUserDoc() {
      return request.resource.data.id == resource.data.id;
    }

    /**
     * Validates a new WatchlistItem document on creation.
     * Ensures the item is correctly associated with its parent user path.
     */
    function isValidNewWatchlistItem(userId) {
      return request.resource.data.userId == userId;
    }

    /**
     * Validates a WatchlistItem document on update.
     * Enforces immutability of the 'userId' field, locking in ownership.
     */
    function isImmutableWatchlistItem() {
      return request.resource.data.userId == resource.data.userId;
    }

    // ----------------------------------------------------------------------
    // Collection Rules
    // ----------------------------------------------------------------------

    /**
     * @description Controls access to a user's own profile document.
     * @path /users/{userId}
     * @allow A signed-in user (auth.uid='user123') can create their own profile at /users/user123. (create)
     * @deny A signed-in user (auth.uid='user456') cannot read another user's profile at /users/user123. (get)
     * @principle Restricts access to a user's own data tree and prevents user enumeration.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // CRITICAL: Prevents listing all users in the app.
      allow create: if isOwner(userId) && isValidNewUserDoc(userId);
      allow update: if isExistingOwner(userId) && isImmutableUserDoc();
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Provides public, read-only access to global stock information.
     * @path /stocks/{stockId}
     * @allow Any user, signed-in or not, can read stock data at /stocks/AAPL. (get)
     * @deny Any user attempting to modify stock data at /stocks/AAPL is denied. (update)
     * @principle Segregates public read-only data from private user data.
     */
    match /stocks/{stockId} {
      allow get: if true;
      allow list: if true;
      allow create: if false; // This data should be managed by a trusted backend process, not clients.
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Secures a user's private watchlist items.
     * @path /users/{userId}/watchlist/{watchlistItemId}
     * @allow A signed-in user (auth.uid='user123') can add a new item to their own watchlist at /users/user123/watchlist/itemABC. (create)
     * @deny A signed-in user (auth.uid='user456') cannot list items in another user's watchlist at /users/user123/watchlist. (list)
     * @principle Enforces document ownership for all operations within a user's private subcollection.
     */
    match /users/{userId}/watchlist/{watchlistItemId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidNewWatchlistItem(userId);
      allow update: if isExistingOwner(userId) && isImmutableWatchlistItem();
      allow delete: if isExistingOwner(userId);
    }
  }
}