<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--  Baseline Checkstyle ruleset for this framework's Java code, deliberately
  narrow: this is not a full style guide (that's what -c google_checks.xml or
  -c sun_checks.xml, bundled in the checkstyle jar itself, are for) — it is
  the specific set of checks that catch the "hardcoding and silly mistakes"
  class of problem that neither Google's nor Sun's bundled configs enable by
  default. Run both if you want full style coverage plus these.

  Each module below was verified against a deliberately bad Java file during
  this framework's audit:
    MagicNumber    -> caught `x * 86400 + 42` (arithmetic magic numbers;
                       Python's ruff PLR2004 only catches magic numbers in
                       *comparisons*, not arithmetic — this is stricter)
    UnusedImports  -> caught an unused `import java.util.List;`
    EmptyCatchBlock-> caught a `catch (Exception e) {}` swallowing an error
    EqualsHashCode -> catches overriding equals() without hashCode() (a
                       correctness bug, not just style)

  Discovered via g4_executable.sh:CHECKSTYLE_JAR (see that script). A
  project's own checkstyle.xml at the repo root takes precedence over this
  file; this is the fallback baseline, not a mandate.-->
<module name="Checker">
  <module name="TreeWalker">
    <module name="MagicNumber">
      <property name="ignoreNumbers" value="-1, 0, 1, 2"/>
      <property name="ignoreFieldDeclaration" value="true"/>
    </module>
    <module name="UnusedImports"/>
    <module name="EmptyCatchBlock"/>
    <module name="EqualsHashCode"/>
  </module>
</module>
