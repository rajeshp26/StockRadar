# Source-distribution contents beyond the importable packages.
#
# The wheel ships the `framework` package tree (including all of framework/opencode/**) via
# package-data in pyproject.toml. These entries add what is NOT inside an importable package but
# must travel with the distribution: the root files the framework owns and the sibling
# .lifecycle/ tree that `framework init` materialises into an application repository.
#
# The framework's own documents live under framework/docs/ (README.md,
# AGENTIC_ARCHITECTURE.md, TEAM_LEAD.md, MANIFEST.md, ...); `pyproject.toml` reads its long
# description from framework/docs/README.md, so that tree must be in the sdist.
include AGENTS.md
include requirements-framework.txt
include .gitattributes
recursive-include framework *.json *.yaml *.yml *.sh *.md *.txt *.ts *.mjs *.js *.cjs
recursive-include .lifecycle *
# The advisory design-skill corpus carries extensionless LICENSE files the extension list
# above would drop. framework/docs/ carries .html eval fixtures for the same reason.
recursive-include framework/design/skills *
recursive-include framework/docs *.html
# The reference application is framework-owned and must travel with the distribution: the
# standalone proof stages it from inside the installed package. `*` (not the extension list
# above) because it also carries .py, .tsx, .css and .html the app needs to build.
recursive-include framework/reference-app *
global-exclude *.pyc
global-exclude *.py[cod]
global-exclude __pycache__/*
