
{
  "project": "StockerPro",
  "architecture": "Next.js Bridge Proxy <-> FastAPI <-> Supabase",
  "entities": {
    "User": {
      "table": "users",
      "properties": {
        "user_id": "serial (PK)",
        "firebase_uid": "text (unique)",
        "email": "varchar(255)",
        "username": "varchar(100)",
        "preferred_currency": "varchar(3) default USD"
      }
    },
    "Watchlist": {
      "table": "watchlists",
      "properties": {
        "id": "serial (PK)",
        "user_id": "integer (FK)",
        "watchlist_name": "varchar(100)",
        "is_default": "boolean"
      }
    },
    "WatchlistItem": {
      "table": "watchlist_items",
      "properties": {
        "watchlist_item_id": "serial (PK)",
        "watchlist_id": "integer (FK)",
        "company_id": "integer (FK)",
        "target_buy": "numeric(10,2)",
        "target_sell": "numeric(10,2)"
      }
    },
    "FinancialData": {
      "tables": [
        "income_statements",
        "balance_sheets",
        "cash_flow_statements",
        "statistics",
        "dividend_history",
        "earnings"
      ],
      "sync_strategy": "Asynchronous background ingestion via yfinance"
    }
  },
  "endpoints": {
    "sync_user": {
      "path": "/users/sync",
      "method": "POST",
      "purpose": "Ensures Firebase user exists in Supabase PostgreSQL"
    },
    "get_watchlist": {
      "path": "/watchlists/default-with-items",
      "method": "POST",
      "purpose": "Retrieves watchlist structure and synchronous market snapshot"
    },
    "add_stock": {
      "path": "/watchlist-items",
      "method": "POST",
      "purpose": "Adds stock to watchlist and triggers asynchronous deep sync",
      "patterns": ["Fast Add", "Deep Sync Worker"]
    }
  },
  "real_time": {
    "protocol": "Server-Sent Events (SSE)",
    "path": "/watchlists/stream",
    "strategy": "Pub/Sub based on symbol interest map"
  }
}
