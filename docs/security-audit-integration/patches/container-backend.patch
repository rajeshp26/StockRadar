diff --git a/framework/security/sandbox_policy.yaml b/framework/security/sandbox_policy.yaml
--- a/framework/security/sandbox_policy.yaml
+++ b/framework/security/sandbox_policy.yaml
@@ -48,3 +48,31 @@
 read_only:
   - kind: target_dir
   - kind: toolchain_roots   # /usr /bin /sbin /lib* /etc
+
+# Enforcement backends. The controls above are declared once; each backend supplies at least
+# one capability the other cannot, and the probe picks the first enforceable one:
+#   native    -- bubblewrap + unprivileged user namespaces. Preferred while available: the
+#                user namespace is a real kernel boundary.
+#   container -- an OCI image run with the controls below. The fallback, and the reason a
+#                fresh project needs no host provisioning: the image carries POSIX node >=18
+#                (the artifact validators need O_NOFOLLOW), python3 and git.
+# A container shares the host kernel, so it is weaker than the native boundary and is never
+# preferred. Absent both, execution is refused (mode: fail_closed above).
+backends:
+  native:
+    requires: [user_namespaces, os_sandbox]
+  container:
+    image: agentic-lifecycle/sandbox:1
+    build: framework/container/build.sh
+    dockerfile: framework/container/Dockerfile
+    why: supplies the POSIX toolchain and becomes the boundary where user namespaces are unavailable
+    probe: [container_engine, container_image, container_start, container_binds]
+    controls:
+      - network=none
+      - read_only_rootfs
+      - cap_drop_all
+      - no_new_privileges
+      - pids_memory_fsize_limits
+      - target_dir_bound_read_only_path_preserving
+      - scratch_bound_read_write_path_preserving
+      - environment_allowlist_via_env_i   # Docker cannot unset the image's own ENV
