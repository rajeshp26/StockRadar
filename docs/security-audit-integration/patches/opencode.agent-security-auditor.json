{
  "security-auditor": {
    "description": "Hunts vulnerabilities in a scoped change or codebase and reports evidence-backed findings. Independent of the implementer.",
    "mode": "subagent",
    "permission": {
      "edit": {
        "*": "deny",
        ".planning/audits/**": "allow"
      },
      "task": {
        "*": "deny"
      },
      "bash": {
        "*": "deny",
        "python3 framework/adapters/sandbox.py*": "allow",
        "python3 framework/adapters/gsd_state.py*": "allow",
        "python3 framework/*": "allow",
        "./framework/*": "allow",
        "bash framework/*": "allow",
        "git status*": "allow",
        "git diff*": "allow",
        "git log*": "allow",
        "git show*": "allow",
        "Get-ChildItem*": "allow",
        "Get-Content*": "allow",
        "Test-Path*": "allow"
      }
    },
    "tools": {
      "playwright*": false
    },
    "model": "opencode/big-pickle",
    "temperature": 0.1,
    "_model_rationale": "Adversarial hunting on a scoped diff. A missed vulnerability costs more than the tokens saved."
  }
}
